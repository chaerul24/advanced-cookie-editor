{
  "manifest_version": 3,
  "name": "Advanced Cookie Editor",
  "version": "1.0.0",
  "description": "Professional Chrome Extension for inspecting, editing, creating, exporting, and managing cookies with AES-GCM encrypted backup.",
  "permissions": [
    "cookies",
    "storage",
    "contextMenus",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Advanced Cookie Editor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
